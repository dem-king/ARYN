VITE_APP_STORE_SECURE_KEY=aryn_mall_secure_key_2025_8f3a7d2e

# 密码加密密钥（CBC模式）
VITE_PWD_PRIVATE_KEY=VyBcekSelErhMYN4
# 是否开启单体服务
VITE_OPEN_BOOT=true
