# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
# vue-router 的模式
VITE_ROUTER_HISTORY=hash
# 生成微信小程序码要打开的小程序版本 正式版为 "release"，体验版为 "trial"，开发版为 "develop"
VITE_WX_MINI_APP_VERSION=develop
