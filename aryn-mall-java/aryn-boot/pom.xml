<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>aryn</artifactId>
        <groupId>com.aryn</groupId>
        <version>3.2.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <description>单体版本启动模块</description>
    <packaging>jar</packaging>

    <artifactId>aryn-boot</artifactId>

    <dependencies>
        <!--        认证中心-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--                用户权限管理-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-upms-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--                订单模块-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-order-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--                支付模块-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-pay-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--                商品模块-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-product-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--                营销模块-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-promotion-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--        会员模块-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-user-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--        站内信模块-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-notify-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-generator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
        <!--            安全模块-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-common-security</artifactId>
        </dependency>
        <!--            swagger-->
        <dependency>
            <groupId>com.aryn</groupId>
            <artifactId>aryn-common-swagger</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>