<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aryn.cloud.product.mapper.GoodsSkuMapper">
    <sql id="goodsSkuSql">
        goods_sku.id,
        goods_sku.spu_id,
        goods_sku.sales_price,
        goods_sku.original_price,
        goods_sku.cost_price,
        goods_sku.stock,
        goods_sku.`status`,
        goods_sku.create_time,
        goods_sku.update_time,
        goods_sku.del_flag,
        goods_sku.specs_arr,
        goods_sku.pic_url
    </sql>
    <resultMap id="goodsSkuResultMap" type="com.aryn.cloud.product.api.entity.GoodsSku">
        <id column="id" property="id"/>
        <result column="spu_id" property="spuId"/>
        <result column="sales_price" property="salesPrice"/>
        <result
                column="specs_arr"
                property="specsArr"
                jdbcType="VARCHAR"
                typeHandler="com.aryn.cloud.product.api.hanlder.SpecsListTypeHandler"/>
    </resultMap>
    <select id="selectBySpuId" resultMap="goodsSkuResultMap">
        SELECT
        <include refid="goodsSkuSql"/>
        FROM goods_sku AS goods_sku
        where goods_sku.`spu_id` = #{spuId}
        AND goods_sku.`del_flag` = '0'
    </select>
    <select id="selectListByIds" resultMap="placeOrderSkuResultMap">
        SELECT
        <include refid="goodsSkuSql"/>
        FROM
        goods_sku AS goods_sku
        WHERE
        goods_sku.`status` = '0'
        AND goods_sku.`del_flag` = '0'
        AND goods_sku.id IN
        <foreach item="item" collection="ids" separator="," open="(" close=")" index="">
            #{item}
        </foreach>
    </select>
    <select id="selectSkuByIds" resultMap="goodsSkuResultMap">
        SELECT
        <include refid="goodsSkuSql"/>
        FROM
        goods_sku AS goods_sku
        WHERE
        goods_sku.`status` = '0'
        AND goods_sku.`del_flag` = '0'
        AND goods_sku.id IN
        <foreach item="item" collection="ids" separator="," open="(" close=")" index="">
            #{item}
        </foreach>
    </select>
    <resultMap id="placeOrderSkuResultMap" type="com.aryn.cloud.product.api.entity.GoodsSku">
        <collection property="goodsSpu" column="{id=spu_id}"
                    ofType="com.aryn.cloud.product.api.entity.GoodsSpu"
                    select="com.aryn.cloud.product.mapper.GoodsSpuMapper.selectById"></collection>
    </resultMap>

    <update id="reduceStockWithOptimisticLock">
        UPDATE goods_sku
        SET stock = stock - #{stockNum},
            version = version + 1
        WHERE id = #{skuId}
          AND stock >= #{stockNum}
          AND version = #{version}
          AND del_flag = '0'
    </update>
</mapper>