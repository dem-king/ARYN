# port 端口号
VITE_PORT = 8888

# 租户id
VITE_TENANT_ID=1590229800633634816

# 是否开启单体服务
VITE_OPEN_BOOT=true

# 默认语言（不配置则跟随系统语言）：zh-CN / en-US
# VITE_DEFAULT_LOCALE=en-US

# 客服接入模式：IN_APP=站内客服会话（默认），NATIVE=微信原生客服按钮（button open-type="contact"）
# GoodsFooter 读取该变量做分支；站内客服页（sub-pages/message/chat）不受影响
VITE_CUSTOMER_SERVICE_MODE=IN_APP
